generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  uid            String   @id @default(uuid())
  email          String   @unique
  nickname       String   @default("")
  avatar         String   @default("")
  level          String   @default("FREE") // FREE or PRO
  role           String   @default("USER") // USER, ASSISTANT, SUPER_ADMIN
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  storage_usage  Int      @default(0) // 以字节为单位的存储用量
  last_ip        String?
  last_ua        String?
  first_active_at DateTime?
  last_active_at  DateTime?

  tasks          Task[]
  executionLogs  ExecutionLog[]
  dailyAnchors   DailyAnchor[]
  habitTemplates HabitTemplate[]
  goals          Goal[]
  feedbacks      Feedback[]

  @@map("users")
}

model Task {
  id                         Int      @id @default(autoincrement())
  local_id                   Int
  title                      String
  est_time                   Int
  act_time                   Int
  status                     String
  tags                       String[]
  is_school_done             Boolean
  date                       String
  created_at                 DateTime
  updated_at                 DateTime
  description                String?
  difficulty                 Int?
  confidence                 Boolean?
  initial_estimated_duration Int?
  comments                   String?
  template_id                String?
  skip_reason                String?
  goal_id                    String?
  is_session                 Boolean?

  userId                     String
  user                       User     @relation(fields: [userId], references: [uid], onDelete: Cascade)
  
  logs                       ExecutionLog[]

  @@unique([userId, local_id])
  @@map("tasks")
}

model ExecutionLog {
  id        Int      @id @default(autoincrement())
  local_id  Int
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startTime DateTime 
  endTime   DateTime?
  
  userId    String
  user      User     @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@unique([userId, local_id])
  @@map("execution_logs")
}

model DailyAnchor {
  id           Int      @id @default(autoincrement())
  date         String   // YYYY-MM-DD
  start_anchor DateTime?
  end_anchor   DateTime?

  userId       String
  user         User     @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_anchors")
}

model HabitTemplate {
  id                 String   @id @default(uuid())
  title              String
  estimated_duration Int
  tags               String[]
  frequency_type     String
  frequency_rule     Int[]
  end_type           String?
  end_date           String?
  end_occurrences    Int?
  generated_count    Int?
  status             String
  description        String?
  difficulty         Int?
  confidence         Boolean?
  created_at         DateTime

  userId             String
  user               User     @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@map("habit_templates")
}

model Goal {
  id                       String   @id @default(uuid())
  title                    String
  description              String?
  total_estimated_duration Int
  deadline                 String?
  difficulty               Int?
  confidence               Boolean?
  status                   String
  created_at               DateTime
  updated_at               DateTime?

  userId             String
  user               User     @relation(fields: [userId], references: [uid], onDelete: Cascade)

  comments           GoalComment[]

  @@map("goals")
}

model GoalComment {
  id         String   @id @default(uuid())
  goal_id    String
  goal       Goal     @relation(fields: [goal_id], references: [id], onDelete: Cascade)
  user_role  String
  content    String
  created_at DateTime

  @@map("goal_comments")
}

model SystemConfig {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt

  @@map("system_configs")
}

model OcrCache {
  id         String   @id @default(uuid())
  image_md5  String   @unique
  result     String
  created_at DateTime @default(now())

  @@map("ocr_cache")
}

model OcrUsageLog {
  id         String   @id @default(uuid())
  userId     String
  created_at DateTime @default(now())

  @@index([userId, created_at])
  @@map("ocr_usage_logs")
}

model SiteVisitLog {
  id         String   @id @default(uuid())
  ip         String
  ua         String
  path       String
  date_str   String
  created_at DateTime @default(now())

  @@index([date_str])
  @@index([ip, date_str])
  @@map("site_visit_logs")
}

model Feedback {
  id         String   @id @default(uuid())
  content    String
  images     String[] // 用来储存用户上传后的图片云端 URL 或 Base64
  status     String   @default("OPEN") // 状态: OPEN(待处理), RESOLVED(已解决), CLOSED(已关闭)
  reply      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  userId     String
  user       User     @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("feedbacks")
}
